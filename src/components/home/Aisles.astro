---
import Icon from '@/components/ui/Icon.astro';
import Picture from '@/components/ui/Picture.astro';
import { localizePath, translator, type Locale } from '@/i18n';
import { common } from '@/i18n/ns/common';
import { home } from '@/i18n/ns/home';
import type { Category } from '@/lib/api/types';

interface Props {
  locale: Locale;
  categories: Category[];
}

const { locale, categories } = Astro.props;
const t = translator(home, locale);
const tc = translator(common, locale);
/** The bento's five tiles, in order: a large navy lead, then paper, yellow, green and white. */
const TILES = ['b1', 'b2', 'b3', 'b4', 'b5'];
---

<section class="sec" id="aisles">
  <div class="wrap">
    <div class="sec-h rv">
      <div>
        <span class="eyebrow">{t('aislesEyebrow')}</span>
        <h2 class="hd">{t('aislesTitle1')}<br />{t('aislesTitle2')}</h2>
      </div>
      <p>{t('aislesLead')}</p>
    </div>
    <div class="bento">
      {
        categories.slice(0, TILES.length).map((category, index) => (
          <a class:list={['bt', TILES[index], 'rv']} href={localizePath(locale, `/shop/${category.handle}`)}>
            <Picture media={category.image} alt="" sizes={index === 0 ? '(max-width: 900px) 40vw, 320px' : '(max-width: 900px) 28vw, 170px'} />
            <h3 class="hd">{category.name}</h3>
            <span class="bt-b">{category.description}</span>
            <small>{category.productCount} {tc(category.productCount === 1 ? 'product' : 'products')}<Icon name="arrowRight" /></small>
          </a>
        ))
      }
    </div>
  </div>
</section>
