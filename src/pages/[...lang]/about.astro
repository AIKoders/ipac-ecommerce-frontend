---
import '@/styles/content.css';
import '@/styles/home.css';
import PageHead from '@/components/ui/PageHead.astro';
import Picture from '@/components/ui/Picture.astro';
import { localeFromParam, localeStaticPaths, localizePath, translator } from '@/i18n';
import { about } from '@/i18n/ns/about';
import { common } from '@/i18n/ns/common';
import { seo } from '@/i18n/ns/seo';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { localMedia } from '@/lib/media';
import { ORGANIZATION_ID, WEBSITE_ID, absoluteUrl, breadcrumbList } from '@/lib/seo';

export const getStaticPaths = localeStaticPaths;

const locale = localeFromParam(Astro.params.lang);
const t = translator(about, locale);
const tc = translator(common, locale);
const ts = translator(seo, locale);
const url = absoluteUrl(locale, '/about');
const values = [
  { figure: '30+', title: t('val1Title'), body: t('val1Body') },
  { figure: '1', title: t('val2Title'), body: t('val2Body') },
  { figure: '0', title: t('val3Title'), body: t('val3Body') },
];
const graph = [
  breadcrumbList([
    { name: tc('home'), url: absoluteUrl(locale, '/') },
    { name: tc('about'), url },
  ]),
  {
    '@type': 'AboutPage',
    '@id': `${url}#webpage`,
    url,
    name: ts('aboutTitle'),
    description: ts('aboutDescription'),
    inLanguage: locale,
    isPartOf: { '@id': WEBSITE_ID },
    about: { '@id': ORGANIZATION_ID },
  },
];
---

<BaseLayout locale={locale} title={ts('aboutTitle')} description={ts('aboutDescription')} path="/about" ogKey="about" section="about" graph={graph}>
  <PageHead eyebrow={t('eyebrow')} title={t('title')} lead={t('lead')} />
  <main id="main" class="sec">
    <div class="wrap flex flex-col gap-[72px]">
      <div class="split">
        <Picture media={localMedia('photos', 'warehouse-aisle', t('photoAlt'))} sizes="(max-width: 960px) 100vw, 580px" class="photo rv" />
        <div class="rv light flex flex-col items-start gap-[18px]">
          <span class="eyebrow">{t('storyEyebrow')}</span>
          <h2 class="hd h2">{t('storyTitle')}</h2>
          <p class="mut">{t('story1')}</p>
          <p class="mut">{t('story2')}</p>
          <a class="btn" href={localizePath(locale, '/contact?topic=consultation')}>{tc('bookConsultation')}</a>
        </div>
      </div>
      <div class="vals">
        {
          values.map((value) => (
            <div class="val rv">
              <b>{value.figure}</b>
              <span class="hd text-[20px]">{value.title}</span>
              <span class="mut">{value.body}</span>
            </div>
          ))
        }
      </div>
      <div class="sv big rv col-auto">
        <Picture media={localMedia('photos', 'delivery-van', t('vanAlt'))} sizes="(max-width: 900px) 100vw, 620px" />
        <div>
          <span class="eyebrow text-yellow">{t('deliverEyebrow')}</span>
          <h2 class="hd text-[32px]">{t('deliverTitle')}</h2>
          <p class="text-mist">{t('deliverBody')}</p>
          <a class="btn y" href={localizePath(locale, '/shop')}>{tc('shopSupplies')}</a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
