# Copy to .env for local work (`koda_pull_env`, or fill by hand). Every value
# lives in Koda: ipac / storefront / <environment>.

# Canonical origin of this deployment (no trailing slash).
PUBLIC_SITE_URL=http://localhost:4321
# production | staging | development
PUBLIC_APP_ENV=development
# Only production is indexed; everything else sends noindex.
PUBLIC_INDEXABLE=false

# Where the storefront gets its data: "mock" (fixtures + localStorage) or "http" (Kart).
PUBLIC_API_MODE=mock
# Kart store surface, e.g. https://kart.aikoders.us/store/v1 (http mode only).
PUBLIC_API_URL=
# Kart publishable key, pk_… (public by design; http mode only).
PUBLIC_KART_KEY=

# KPulse: maintenance gate, error reports. The key is server-only.
KPULSE_URL=https://kpulse.aikoders.us
KPULSE_ENVIRONMENT=development
KPULSE_KEY=
